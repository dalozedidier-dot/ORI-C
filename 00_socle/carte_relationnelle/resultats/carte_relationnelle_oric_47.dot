	"TR-001" -> "TR-004" [color="#666666" constraint=false style=dashed tooltip="CNST: contraint - Les masses et couplages issus du régime électrofaible brisé contraignent les réactions et abondances de la nucléosynthèse primordiale."]
	"TR-002" -> "TR-004" [color="#666666" constraint=false style=dashed tooltip="CNST: contraint - L’asymétrie matière-antimatière détermine la quantité baryonique nette qui subsiste après les annihilations et constitue un paramètre d’entrée de la nucléosynthèse primordiale. Elle ne cause pas le confinement des quarks."]
	"TR-003" -> "TR-004" [color="#A76523" constraint=false style=solid tooltip="MATR: fournit les constituants - Les protons et neutrons issus du confinement fournissent les constituants de la nucléosynthèse primordiale."]
	"TR-004" -> "TR-005" [color="#A76523" constraint=false style=solid tooltip="MATR: fournit les constituants - Les noyaux légers produits dans l’Univers primordial s’associent ensuite aux électrons lors de la recombinaison."]
	"TR-005" -> "TR-011" [color="#2F6B45" constraint=true minlen=2 style=solid tooltip="ENBL: rend possible - Au cours de la recombinaison cosmologique, l’hélium devient neutre avant l’hydrogène. L’hélium neutre peut alors s’associer radiativement aux protons pour former HeH+."]
	"TR-005" -> "TR-012" [color="#2F6B45" constraint=true minlen=2 style=solid tooltip="ENBL: rend possible - La recombinaison rend possible la formation durable de H2 et HD dans le gaz primordial."]
	"TR-012" -> "TR-006" [color="#2F6B45" constraint=false style=solid tooltip="ENBL: rend possible - Le refroidissement par H2 et HD facilite l’effondrement des premiers nuages stellaires."]
	"TR-006" -> "TR-007" [color="#2F6B45" constraint=false style=solid tooltip="ENBL: rend possible - La formation des premières étoiles ouvre la nucléosynthèse stellaire. L’existence historique des étoiles de Population III est très fortement inférée, mais leurs masses et leur distribution restent ouvertes."]
	"TR-006" -> "TR-008" [color="#2F6B45" constraint=false style=solid tooltip="ENBL: rend possible - La formation et l’évolution d’étoiles de masse faible ou intermédiaire rendent possibles les phases AGB."]
	"TR-007" -> "TR-009" [color="#A76523" constraint=false style=solid tooltip="MATR: fournit les constituants - Les noyaux synthétisés dans les étoiles sont les matériaux dispersés lors des explosions stellaires."]
	"TR-006" -> "TR-010" [color="#2F6B45" constraint=false style=solid tooltip="ENBL: rend possible - L’évolution des étoiles massives rend possible la formation d’étoiles à neutrons et leurs fusions ultérieures."]
	"TR-009" -> "TR-013" [color="#A76523" constraint=true minlen=1 style=solid tooltip="MATR: fournit les constituants - L’enrichissement stellaire fournit le carbone, l’azote et l’oxygène nécessaires à la chimie interstellaire carbonée."]
	"TR-008" -> "TR-014" [color="#A76523" constraint=true minlen=1 style=solid tooltip="MATR: fournit les constituants - Les poussières issues notamment des étoiles AGB fournissent des surfaces sur lesquelles se déposent les manteaux de glace."]
	"TR-014" -> "TR-015" [color="#2F6B45" constraint=false style=solid tooltip="ENBL: rend possible - La chimie de surface et le réchauffement des glaces ouvrent des voies vers plusieurs molécules organiques complexes."]
	"TR-008" -> "TR-016" [color="#A76523" constraint=true minlen=2 style=solid tooltip="MATR: fournit les constituants - Les étoiles AGB constituent une source importante de grains présolaires."]
	"TR-016" -> "TR-017" [color="#A76523" constraint=false style=solid tooltip="MATR: fournit les constituants - Les grains et le gaz enrichi fournissent les constituants incorporés dans les CAI."]
	"TR-016" -> "TR-019" [color="#A76523" constraint=false style=solid tooltip="MATR: fournit les constituants - Les grains solides participent au réservoir de particules susceptible d’être concentré collectivement dans les disques."]
	"TR-019" -> "TR-020" [color="#2F6B45" constraint=false style=solid tooltip="ENBL: rend possible - La concentration collective des galets peut conduire à l’effondrement gravitationnel en planétésimaux puis à la croissance d’embryons."]
	"TR-020" -> "TR-021" [color="#2F6B45" constraint=true minlen=1 style=solid tooltip="ENBL: rend possible - La croissance des corps et l’énergie d’accrétion rendent possible la différenciation métal-silicate."]
	"TR-020" -> "TR-022" [color="#2F6B45" constraint=true minlen=1 style=solid tooltip="ENBL: rend possible - L’accrétion, les impacts et les radionucléides peuvent produire des océans magmatiques."]
	"TR-022" -> "TR-023" [color="#2F6F94" constraint=false style=solid tooltip="ENVR: modifie l'environnement - Sur Terre, le refroidissement, la cristallisation, le dégazage et les apports volatils ont rendu possible une hydrosphère ancienne. Pour les exoplanètes rocheuses, les hydrosphères restent des scénarios de modèle."]
	"TR-022" -> "TR-024" [color="#2F6F94" constraint=false style=solid tooltip="ENVR: modifie l'environnement - Le dégazage des réservoirs internes peut produire une atmosphère secondaire. JWST soutient fortement une atmosphère volatile sur 55 Cancri e, possiblement couplée à un océan magmatique."]
	"TR-021" -> "TR-025" [color="#2F6B45" constraint=false style=solid tooltip="ENBL: rend possible - Une planète différenciée possédant manteau et croûte fournit l’architecture nécessaire à un recyclage tectonique global."]
	"TR-023" -> "TR-026" [color="#2F6B45" constraint=true minlen=1 style=solid tooltip="ENBL: rend possible - L’eau liquide rend possible l’altération aqueuse et la formation d’argiles."]
	"TR-023" -> "TR-027" [color="#2F6B45" constraint=true minlen=1 style=solid tooltip="ENBL: rend possible - Les hydrosphères permettent le transport, la concentration et la précipitation chimique à grande échelle."]
	"TR-021" -> "TR-028" [color="#2F6B45" constraint=true minlen=1 style=solid tooltip="ENBL: rend possible - Les impacts, l’enfouissement et les gradients internes des corps différenciés ouvrent des domaines de haute pression et de choc."]
	"TR-038" -> "TR-029" [color="#2F6F94" constraint=false style=solid tooltip="ENVR: modifie l'environnement - La photosynthèse oxygénique transforme progressivement l’état redox des océans, de l’atmosphère et des surfaces."]
	"TR-036" -> "TR-030" [color="#596B7A" constraint=false style=dotted tooltip="DEPG: dépendance fonctionnelle générale - Toute biominéralisation biologique connue mobilise une machinerie d’expression et de régulation génétiques, donc suppose déjà un code et une traduction fonctionnels. Le lien signale cet arrière-plan fonctionnel général."]
	"TR-026" -> "TR-031" [color="#8A6D2F" constraint=true minlen=1 style=solid tooltip="CATL: catalyse - Les surfaces minérales et argileuses peuvent concentrer ou catalyser certaines chimies de précurseurs, sans établir la voie historique réelle."]
	"TR-031" -> "TR-032" [color="#A76523" constraint=false style=solid tooltip="MATR: fournit les constituants - Les précurseurs compatibles fournissent les monomères nécessaires aux étapes de concentration, activation et polymérisation."]
	"TR-031" -> "TR-033" [color="#A76523" constraint=false style=solid tooltip="MATR: fournit les constituants - Les précurseurs lipidiques ou amphiphiles fournissent les constituants nécessaires à l’auto-assemblage de compartiments."]
	"TR-032" -> "TR-034" [color="#2F6B45" constraint=false style=solid tooltip="ENBL: rend possible - La concentration et la polymérisation ouvrent la possibilité de réseaux autocatalytiques plus intégrés."]
	"TR-032" -> "TR-035" [color="#2F6B45" constraint=false style=solid tooltip="ENBL: rend possible - La production de polymères nucléotidiques est un préalable à la catalyse ARN et à la copie dirigée par matrice."]
	"TR-035" -> "TR-036" [color="#2F6B45" constraint=true minlen=1 style=solid tooltip="ENBL: rend possible - La catalyse ARN et la copie constituent des mécanismes candidats en amont de l’établissement du code et de la traduction."]
	"TR-036" -> "TR-037" [color="#2F6B45" constraint=false style=solid tooltip="ENBL: rend possible - LUCA est reconstruit comme un organisme déjà doté d’un système génétique et traductionnel complexe; le code et la traduction précèdent donc logiquement LUCA."]
	"TR-037" -> "TR-038" [color="#555555" constraint=false style=dotted tooltip="DESC: ascendance générale - La photosynthèse oxygénique apparaît dans des lignées descendantes du vivant cellulaire dont LUCA est l’ancêtre commun reconstruit."]
	"TR-037" -> "TR-039" [color="#555555" constraint=false style=dotted tooltip="DESC: ascendance générale - L’endosymbiose mitochondriale survient dans une lignée eucaryote très postérieure à LUCA, au sein de la descendance cellulaire commune."]
	"TR-039" -> "TR-040" [color="#2F6B45" constraint=false style=solid tooltip="ENBL: rend possible - L’architecture eucaryote issue de l’endosymbiose mitochondriale fournit une organisation énergétique et cellulaire compatible avec plusieurs formes de multicellularité complexe."]
	"TR-009" -> "TR-016" [color="#A76523" constraint=true minlen=2 style=solid tooltip="MATR: fournit les constituants - Les éjecta stellaires enrichis condensent et alimentent une partie des grains présolaires."]
	"TR-013" -> "TR-014" [color="#A76523" constraint=false style=solid tooltip="MATR: fournit les constituants - Les molécules simples du gaz sont incorporées ou transformées dans les manteaux de glace des grains."]
	"TR-017" -> "TR-018" [color="#8B6F47" constraint=false style=dotted tooltip="INCO: incorporation ou trace - Les CAI sont généralement antérieures aux chondres. Des fragments réfractaires peuvent être incorporés, remaniés ou partiellement refondus dans certains chondres; ce lien n’indique pas que les CAI produisent les chondres."]
	"TR-018" -> "TR-019" [color="#A76523" constraint=false style=solid tooltip="MATR: fournit les constituants - Les chondres contribuent à la population de solides millimétriques concentrée par les mécanismes hydrodynamiques, sans en être les seuls constituants."]
	"TR-024" -> "TR-023" [color="#725B8C" constraint=false style=solid tooltip="STAB: stabilise - Une atmosphère peut élargir le domaine de stabilité de l’eau liquide en contrôlant pression, température et redistribution thermique."]
	"TR-023" -> "TR-025" [color="#7A5E99" constraint=false style=dashed tooltip="CONT: contribue ou favorise - L’eau peut modifier la rhéologie du manteau et de la lithosphère et favoriser certaines conditions de subduction. Une hydrosphère ne suffit toutefois pas à déclencher ni à maintenir une tectonique globale."]
	"TR-033" -> "TR-034" [color="#725B8C" constraint=false style=solid tooltip="STAB: stabilise - La compartimentation peut retenir des réactifs et stabiliser localement des réseaux autocatalytiques."]
	"TR-029" -> "TR-038" [color="#A52A2A" constraint=false minlen=2 penwidth=2.0 style=bold tooltip="FEED: rétroaction - Après l’apparition de la photosynthèse oxygénique, l’oxygénation durable modifie les niches, les cycles nutritifs et les contraintes écologiques des lignées photosynthétiques. Il s’agit d’une rétroaction tardive, non de l’origine de la photosynthèse."]
	"TR-029" -> "TR-040" [color="#2F6F94" constraint=true minlen=2 style=solid tooltip="ENVR: modifie l'environnement - L’oxygénation modifie les niches et les budgets énergétiques accessibles à plusieurs multicellularités complexes, sans constituer une cause unique."]
	LEGEND [label=<<TABLE BORDER="1" COLOR="#B5BEC5" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2"><TR><TD COLSPAN="5"><B>Codes de liens</B></TD></TR><TR><TD BORDER="0" CELLPADDING="5"><FONT COLOR="#2F6B45"><B>ENBL</B>  rend possible</FONT></TD><TD BORDER="0" CELLPADDING="5"><FONT COLOR="#A76523"><B>MATR</B>  fournit les constituants</FONT></TD><TD BORDER="0" CELLPADDING="5"><FONT COLOR="#2F6F94"><B>ENVR</B>  modifie l&#x27;environnement</FONT></TD><TD BORDER="0" CELLPADDING="5"><FONT COLOR="#725B8C"><B>STAB</B>  stabilise</FONT></TD><TD BORDER="0" CELLPADDING="5"><FONT COLOR="#8A6D2F"><B>CATL</B>  catalyse</FONT></TD></TR><TR><TD BORDER="0" CELLPADDING="5"><FONT COLOR="#666666"><B>CNST</B>  contraint</FONT></TD><TD BORDER="0" CELLPADDING="5"><FONT COLOR="#7A5E99"><B>CONT</B>  contribue ou favorise</FONT></TD><TD BORDER="0" CELLPADDING="5"><FONT COLOR="#596B7A"><B>DEPG</B>  dépendance fonctionnelle générale</FONT></TD><TD BORDER="0" CELLPADDING="5"><FONT COLOR="#8B6F47"><B>INCO</B>  incorporation ou trace</FONT></TD><TD BORDER="0" CELLPADDING="5"><FONT COLOR="#555555"><B>DESC</B>  ascendance générale</FONT></TD><TD BORDER="0" CELLPADDING="5"><FONT COLOR="#A52A2A"><B>FEED</B>  rétroaction</FONT></TD></TR><TR><TD COLSPAN="5"><FONT POINT-SIZE="6.5">INCO, DESC et DEPG sont contextuels et non causaux historiquement; CONT indique une contribution non suffisante.</FONT></TD></TR></TABLE>> color=white fillcolor=white fixedsize=false fontname="DejaVu Sans" fontsize=8.2 height=0 shape=plain style="" width=0]
	"TR-036" -> LEGEND [minlen=2 style=invis weight=1500]
}
