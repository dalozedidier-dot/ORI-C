    "C01": {
      "S_etoile": "-K_s*m/(m - mu_max)",
      "P_etoile": "D*(K_s*m + S_in*m - S_in*mu_max)/(m*(m - mu_max))",
      "jacobien_lavage": "[[-D, -S_in*mu_max/(K_s + S_in)], [0, (S_in*mu_max - m*(K_s + S_in))/(K_s + S_in)]]",
      "valeurs_propres_lavage": [
        "(-K_s*m - S_in*m + S_in*mu_max)/(K_s + S_in)",
        "-D"
      ],
      "trace_interieure": "D*(-K_s*m**2 - S_in*m**2 + 2*S_in*m*mu_max - S_in*mu_max**2)/(K_s*m*mu_max)",
      "determinant_interieur": "D*(m - mu_max)*(K_s*m + S_in*m - S_in*mu_max)/(K_s*mu_max)",
      "dP_dm": "D*(-K_s*m**2 - S_in*m**2 + 2*S_in*m*mu_max - S_in*mu_max**2)/(m**2*(m**2 - 2*m*mu_max + mu_max**2))",
      "numerateur_dP_dm": "-D*(K_s*m**2 + S_in*m**2 - 2*S_in*m*mu_max + S_in*mu_max**2)",
      "forme_positive": "K_s*m**2 + S_in*m**2 - 2*S_in*m*mu_max + S_in*mu_max**2",
      "identite_numerateur_verifiee": true,
      "identite_trace_verifiee": true,
      "divergence_dulac": "-D/P - K_s*mu_max/(K_s + S)**2",
      "theoremes": {
        "C1": "Équilibre de lavage E0 = (S_in, 0), toujours présent. Valeurs propres -D et mu(S_in) - m.",
        "C2": "Équilibre intérieur E* = (K_s m/(mu_max - m), D(S_in - S*)/m), existant et positif si et seulement si m < mu(S_in).",
        "C3": "dP*/dm = -D [K_s m^2 + S_in (m - mu_max)^2] / [m^2 (mu_max - m)^2] < 0 pour tout m > 0, m != mu_max. La décroissance est donc stricte sur tout le domaine admissible, sans condition de viabilité.",
        "C4": "trace J(E*) = -D [K_s m^2 + S_in (m - mu_max)^2] / (K_s m mu_max) < 0 ; det J(E*) > 0 dès que E* est intérieur. E* est donc toujours localement asymptotiquement stable.",
        "C5": "Avec B = 1/P, div(B f) = -D/P - mu'(S) < 0 sur P > 0 : critère de Dulac satisfait, aucune orbite périodique dans le quadrant ouvert."
      },
      "reussi": true,
      "titre": "Théorèmes symboliques"
    },
    "C02": {
      "P_etoile_generique": "D*(S_in - S(m))/m",
      "dP_dm_generique": "D*(-S_in - m*Derivative(S(m), m) + S(m))/m**2",
      "numerateur": "D*(-S_in - m*Derivative(S(m), m) + S(m))",
      "argument": "Le numérateur vaut -D [ m S'(m) + (S_in - S(m)) ]. Sous les hypothèses S'(m) > 0 (mu strictement croissante) et S(m) < S_in (équilibre intérieur), les deux termes sont positifs, donc la dérivée est strictement négative.",
      "hypotheses": [
        "mu strictement croissante",
        "mu dérivable",
        "S* < S_in",
        "m > 0"
      ],
      "reussi": true,
      "titre": "Généralisation à toute mu croissante"
    },
