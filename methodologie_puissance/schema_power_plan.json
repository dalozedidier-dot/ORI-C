{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dalozedidier-dot.github.io/ORI-C/schema_power_plan.json",
  "title": "Plan de puissance a priori ORI-C",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "protocol_id",
    "analysis_frozen_before_data",
    "independent_unit",
    "primary_metric",
    "effect",
    "alpha",
    "target_power",
    "noise_estimation",
    "test_definition",
    "controls",
    "success_rule",
    "simulation_model",
    "adapter",
    "preliminary_simulations",
    "confirmation_simulations",
    "seed"
  ],
  "properties": {
    "protocol_id": {"type": "string", "minLength": 1},
    "analysis_frozen_before_data": {"const": true},
    "independent_unit": {"type": "string", "minLength": 1},
    "primary_metric": {"type": "string", "minLength": 1},
    "effect": {
      "type": "object",
      "required": ["type", "sesoi", "justification"],
      "properties": {
        "type": {
          "enum": [
            "absolute_difference",
            "relative_improvement",
            "standardized_difference",
            "ratio_to_numerical_noise"
          ]
        },
        "sesoi": {"type": "number", "exclusiveMinimum": 0},
        "baseline": {"type": "number", "exclusiveMinimum": 0},
        "scale": {"type": "number", "exclusiveMinimum": 0},
        "justification": {"type": "string", "minLength": 1}
      }
    },
    "alpha": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
    "target_power": {"type": "number", "exclusiveMinimum": 0, "exclusiveMaximum": 1},
    "available_n": {"type": "integer", "minimum": 1},
    "sample_size_grid": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "integer", "minimum": 1}
    },
    "effect_grid": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "number", "exclusiveMinimum": 0}
    },
    "noise_estimation": {
      "type": "object",
      "required": ["source", "description"],
      "properties": {
        "source": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "value": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "test_definition": {"type": "string", "minLength": 1},
    "controls": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "success_rule": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "simulation_model": {"type": "string", "minLength": 1},
    "adapter": {
      "type": "object",
      "required": ["path"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "function": {"type": "string", "minLength": 1}
      }
    },
    "preliminary_simulations": {"type": "integer", "minimum": 500},
    "confirmation_simulations": {"type": "integer", "minimum": 10000},
    "seed": {"type": "integer", "minimum": 0}
  }
}
