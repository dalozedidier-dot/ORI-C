  ],
  "domain_B": [
    "intermediate_oxidizing",
    "strong_oxidizing"
  ],
  "primary_contrast": "mean(JS(vacuum,intermediate),JS(vacuum,strong))-JS(intermediate,strong)",
  "primary_metrics": [
    "contrast_mean_bits",
    "contrast_bootstrap95",
    "positive_temperature_fraction",
    "wilcoxon_greater_p",
    "within_domain_mean_JS_bits"
  ],
  "candidate_rule": {
    "contrast_bootstrap95_lower_min_bits": 0.2,
    "positive_temperature_fraction_min": 0.9,
    "within_domain_mean_JS_max_bits": 0.1
  },
  "interpretation_guard": "Le jeu est une sortie thermochimique de modèle. Une séparation de domaine ici guide une expérience physique future et ne vaut pas démonstration empirique causale.",
